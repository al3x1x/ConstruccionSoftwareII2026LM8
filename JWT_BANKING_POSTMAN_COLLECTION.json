    {
      "name": "SETUP - Guardar Token Commercial (Post-Login)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('token_commercial', jsonData.token);",
              "    console.log('✅ Token Commercial guardado');",
              "}",
              "else {",
              "    console.log('❌ Error al obtener token');",
              "}"
            ]
          }
        }
      ],
